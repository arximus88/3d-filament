---
import Layout from '../layouts/Layout.astro';
import productsData from '../data/products.json';
import companies from '../data/companies.json';
import { relativeTime } from '../utils/relativeTime';
import { resizedImg } from '../utils/imgProxy';
import { colorHex, solidColorHex } from '../utils/colorHex';

interface Product {
  store: string;
  storeType: string;
  brand: string;
  material: string;
  color: string | null;
  weightKg: number | null;
  lengthM: number | null;
  diameterMm: number | null;
  pricePerSpool: number | null;
  pricePerKg: number | null;
  currency: string;
  sku: string | null;
  url: string;
  image: string | null;
  inStock: boolean | null;
  name: string | null;
  checkedAt?: string;
}

const data = productsData as { lastChecked: string; products: Product[]; stats: Record<string, { products: number }> };
const lastChecked = data.lastChecked;

// Cards are rendered in the order the page opens with (price per kg, cheapest
// first, unpriced last), so the client doesn't reshuffle 1000+ nodes on load.
const sortKey = (p: Product) => (p.inStock === true && p.pricePerKg) || Infinity;
const products = [...data.products].sort((a, b) => sortKey(a) - sortKey(b));

// The cards visible under the default filters (in stock, 1.75 mm) without
// scrolling: their photos load eagerly, the first two with high priority —
// one of them is the LCP element. Everything else is lazy.
const firstScreen = products.filter(p => p.inStock === true && p.diameterMm === 1.75).slice(0, 8);
const eager = new Set(firstScreen.map(p => p.url));
const highPriority = new Set(firstScreen.slice(0, 2).map(p => p.url));

const materials = [...new Set(products.map(p => p.material))].sort();
const brands = [...new Set(products.map(p => p.brand))].sort();
// Colours are sorted by how many products carry them (popular ones first),
// then alphabetically as a stable secondary key.
const colorCounts = new Map<string, number>();
for (const p of products) if (p.color) colorCounts.set(p.color, (colorCounts.get(p.color) ?? 0) + 1);
const colors = [...colorCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'uk'))
  .map(([c]) => c);
const storeCount = new Set(products.map(p => p.store)).size;

// Strict-stock encoding: '1' = confirmed in-stock, '0' = confirmed OOS,
// '2' = unknown. The catalog hides anything other than '1' when the
// "Тільки в наявності" filter is on.
function stockCode(inStock: boolean | null): '0' | '1' | '2' {
  if (inStock === true) return '1';
  if (inStock === false) return '0';
  return '2';
}

// Show prices only when we have confirmed availability — otherwise the
// number may be stale (e.g. Monofilament keeps a historical price in
// JSON-LD on out-of-stock pages where the UI hides it).
function visiblePrice<T>(inStock: boolean | null, price: T): T | null {
  return inStock === true ? price : null;
}

// Store id → display name, for every store that has products.
const STORE_NAMES: Record<string, string> = Object.fromEntries(
  (companies as Array<{ id: string; name: string }>)
    .filter(c => products.some(p => p.store === c.id))
    .map(c => [c.id, c.name]),
);

const SITE = 'https://3d-filament.pages.dev';

// SEO: ItemList structured data lets Google surface product cards
// with prices/availability in search results. Only emit entries we can
// fully back with confirmed in-stock + price — otherwise Google will
// flag stale prices and we don't want to mislead crawlers.
const seoProducts = products.filter(p => p.inStock === true && p.pricePerSpool).slice(0, 100);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Каталог філаменту',
  numberOfItems: seoProducts.length,
  itemListElement: seoProducts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name ?? `${p.material} ${p.color ?? ''}`.trim(),
      url: p.url,
      image: p.image ?? undefined,
      sku: p.sku ?? undefined,
      brand: { '@type': 'Brand', name: p.brand },
      offers: {
        '@type': 'Offer',
        priceCurrency: p.currency,
        price: p.pricePerSpool,
        url: p.url,
        availability: 'https://schema.org/InStock',
      },
    },
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Каталог філаменту', item: SITE + '/' },
  ],
};

const seoTitle = `Каталог філаменту України — ${products.length} товарів від ${storeCount} магазинів • ціни і наявність`;
const seoDescription = `Агрегатор пластиків для 3D-друку: ${[...new Set(products.map(p => p.material))].slice(0, 8).join(', ')} та інші. ${products.length} товарів від ${[...new Set(products.map(p => p.brand))].join(', ')}. Сортування за ціною за катушку та за кг, фільтри за матеріалом, кольором, брендом.`;

---

<Layout title={seoTitle} description={seoDescription}>
  <link slot="head" rel="preconnect" href="https://images.weserv.nl" />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  <header class="catalog-header">
    <h1>Каталог філаменту</h1>
    <p class="subtitle">{products.length} товарів від {storeCount} {storeCount === 1 ? 'магазину' : 'магазинів'} • {relativeTime(lastChecked)}</p>
  </header>

  <div class="catalog-layout" id="catalogLayout">
    <aside class="catalog-sidebar" id="catalogSidebar" aria-label="Фільтри">
      <div class="sidebar-header">
        <h2 class="sidebar-title">Фільтри</h2>
        <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Закрити фільтри">✕</button>
      </div>
      <div class="store-pill" id="storePill" hidden>
        <span>Магазин: <strong id="storePillName"></strong></span>
        <a href="/" class="store-pill-clear" id="storePillClear" aria-label="Скинути фільтр магазину">✕</a>
      </div>
      <div class="filter-group">
        <label for="search">Пошук</label>
        <input type="text" id="search" placeholder="Назва, артикул, колір..." autocomplete="off" />
      </div>
      <div class="filter-group">
        <label for="materialFilter">Матеріал</label>
        <select id="materialFilter">
          <option value="all">Всі</option>
          {materials.map(m => <option value={m}>{m}</option>)}
        </select>
      </div>
      <div class="filter-group">
        <label for="brandFilter">Бренд</label>
        <select id="brandFilter">
          <option value="all">Всі</option>
          {brands.map(b => <option value={b}>{b}</option>)}
        </select>
      </div>
      <div class="filter-group">
        <span class="filter-label" id="colorLabel">Колір</span>
        <details class="color-dropdown" id="colorDropdown">
          <summary id="colorSummary" aria-labelledby="colorLabel colorSummary">
            <span class="swatch swatch-all" aria-hidden="true"></span>
            <span class="color-label">Всі</span>
          </summary>
          <div class="color-menu" role="group" aria-labelledby="colorLabel">
            <button type="button" class="color-option" data-value="all">
              <span class="swatch swatch-all" aria-hidden="true"></span>
              <span class="color-name">Всі</span>
            </button>
            {colors.map(c => (
              <button type="button" class="color-option" data-value={c}>
                <span class="swatch" style={`background:${colorHex(c)}`} aria-hidden="true"></span>
                <span class="color-name">{c}</span>
                <span class="color-count">{colorCounts.get(c)}</span>
              </button>
            ))}
          </div>
        </details>
        <input type="hidden" id="colorFilter" value="all" />
      </div>
      <div class="filter-group">
        <label for="diameterFilter">Діаметр нитки</label>
        <select id="diameterFilter">
          <option value="all">Всі</option>
          <option value="1.75" selected>1.75 мм</option>
          <option value="2.9">2.9 мм</option>
        </select>
      </div>
      <div class="filter-group">
        <label for="weightFilter">Вага котушки</label>
        <select id="weightFilter">
          <option value="all">Всі</option>
          <option value="lt05">До 0.5 кг</option>
          <option value="05to1">0.5–1 кг</option>
          <option value="1">1 кг</option>
          <option value="2plus">2+ кг</option>
        </select>
      </div>
      <div class="filter-group">
        <label for="sortFilter">Сортування</label>
        <select id="sortFilter">
          <option value="ppk_asc">Ціна за кг ↑</option>
          <option value="ppk_desc">Ціна за кг ↓</option>
          <option value="pps_asc">Ціна за катушку ↑</option>
          <option value="pps_desc">Ціна за катушку ↓</option>
          <option value="weight_asc">Вага ↑</option>
          <option value="weight_desc">Вага ↓</option>
          <option value="diameter_asc">Діаметр ↑</option>
          <option value="diameter_desc">Діаметр ↓</option>
          <option value="name_asc">Назва А→Я</option>
          <option value="name_desc">Назва Я→А</option>
          <option value="material_asc">Матеріал А→Я</option>
          <option value="brand_asc">Бренд А→Я</option>
        </select>
      </div>
      <div class="filter-group filter-stock">
        <label for="inStockOnly" class="checkbox-label">
          <input type="checkbox" id="inStockOnly" checked />
          Тільки в наявності
        </label>
      </div>
    </aside>

    <div class="sidebar-backdrop" id="sidebarBackdrop" hidden></div>

    <div class="catalog-main">

  <div class="results-bar">
    <div class="results-summary" id="resultsSummary" role="status"></div>
    <div class="view-toggle" role="group" aria-label="Режим перегляду">
      <button type="button" class="view-btn active" data-view="grid" aria-pressed="true">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="0" y="0" width="7" height="7" rx="1"/><rect x="9" y="0" width="7" height="7" rx="1"/><rect x="0" y="9" width="7" height="7" rx="1"/><rect x="9" y="9" width="7" height="7" rx="1"/></svg>
        <span>Сітка</span>
      </button>
      <button type="button" class="view-btn" data-view="table" aria-pressed="false">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="0" y="2" width="16" height="2" rx="0.5"/><rect x="0" y="7" width="16" height="2" rx="0.5"/><rect x="0" y="12" width="16" height="2" rx="0.5"/></svg>
        <span>Таблиця</span>
      </button>
    </div>
  </div>

  <!-- Rows are built in the browser from the cards when the table view is
       first opened (see buildRow), so the product data isn't shipped twice. -->
  <div class="table-scroll" id="tableScroll" role="region" aria-label="Таблиця товарів" tabindex="0" hidden>
    <table class="product-table">
      <thead>
        <tr>
          <th scope="col">Колір</th>
          <th scope="col" data-sort="material"><button type="button" class="sort-btn">Матеріал</button></th>
          <th scope="col" data-sort="brand"><button type="button" class="sort-btn">Бренд</button></th>
          <th scope="col" data-sort="name"><button type="button" class="sort-btn">Назва</button></th>
          <th scope="col" class="num" data-sort="weight"><button type="button" class="sort-btn">Вага</button></th>
          <th scope="col" class="num" data-sort="diameter"><button type="button" class="sort-btn">Діам.</button></th>
          <th scope="col" class="num" data-sort="pps"><button type="button" class="sort-btn">Ціна, грн</button></th>
          <th scope="col" class="num" data-sort="ppk"><button type="button" class="sort-btn">Грн/кг</button></th>
          <th scope="col">Наявність</th>
        </tr>
      </thead>
      <tbody id="productTableBody"></tbody>
    </table>
  </div>
  <template id="rowTemplate">
    <tr class="product-row">
      <td><span class="row-color"><span class="swatch swatch-sm" aria-hidden="true"></span><span data-cell="color"></span></span></td>
      <td><span class="tag tag-material" data-cell="material"></span></td>
      <td data-cell="brand"></td>
      <td><a class="row-link" data-cell="name" target="_blank" rel="noopener noreferrer"></a></td>
      <td class="num" data-cell="weight"></td>
      <td class="num" data-cell="diameter"></td>
      <td class="num" data-cell="pps"></td>
      <td class="num" data-cell="ppk"></td>
      <td><span class="tag" data-cell="stock"></span></td>
    </tr>
  </template>

  <div class="product-grid" id="productGrid">
    {products.map(p => {
      const code = stockCode(p.inStock);
      const pps = visiblePrice(p.inStock, p.pricePerSpool);
      const ppk = visiblePrice(p.inStock, p.pricePerKg);
      return (
      <article
        class="product-card"
        data-material={p.material}
        data-brand={p.brand}
        data-store={p.store}
        data-color={p.color ?? ''}
        data-instock={code}
        data-name={(p.name ?? '').toLowerCase()}
        data-ppk={ppk ?? 0}
        data-pps={pps ?? 0}
        data-weight={p.weightKg ?? 0}
        data-diameter={p.diameterMm ?? 0}
        data-search={`${p.name ?? ''} ${p.sku ?? ''} ${p.color ?? ''} ${p.brand}`.toLowerCase()}
      >
        <a class="product-card-link" href={p.url} target="_blank" rel="noopener noreferrer">
          <div class="product-image" style={`color:${solidColorHex(p.color)}`}>
            <div class="product-image-fallback" aria-hidden="true">
              <svg viewBox="0 0 162 209"><use href="#icon-filament"></use></svg>
            </div>
            {p.image && (
              <img
                src={resizedImg(p.image, 240, 240) ?? p.image}
                srcset={`${resizedImg(p.image, 240, 240) ?? p.image} 1x, ${resizedImg(p.image, 480, 480) ?? p.image} 2x`}
                alt=""
                loading={eager.has(p.url) ? 'eager' : 'lazy'}
                fetchpriority={highPriority.has(p.url) ? 'high' : undefined}
                decoding="async" width="240" height="240" onerror="this.remove()"
              />
            )}
          </div>
          <div class="product-info">
            <div class="product-top">
              <span class="tag tag-material">{p.material}</span>
              <span class="product-brand">{p.brand}</span>
            </div>
            <h3 class="product-name">{p.name ?? `${p.material} ${p.color ?? ''}`}</h3>
            <div class="product-meta">
              {p.color && (
                <span class="meta-color">
                  <span class="swatch swatch-sm" style={`background:${colorHex(p.color)}`} aria-hidden="true"></span>
                  {p.color}
                </span>
              )}
              {p.weightKg && <span>{p.weightKg} кг</span>}
              {p.diameterMm && <span>{p.diameterMm} мм</span>}
            </div>
            <div class="product-price">
              {pps !== null
                ? <span class="price-spool">{pps} <small>{p.currency === 'UAH' ? 'грн' : p.currency}</small></span>
                : <span class={`stock-note stock-note-${code}`}>{code === '0' ? 'Немає в наявності' : 'Уточнюйте наявність'}</span>
              }
              {ppk !== null && <span class="price-kg">{Math.round(ppk)} грн/кг</span>}
            </div>
          </div>
        </a>
      </article>
      );
    })}
  </div>

  <div class="no-results" id="noResults" style="display:none">
    <h3>Нічого не знайдено</h3>
    <p>Спробуйте змінити фільтри.</p>
  </div>
    </div><!-- /.catalog-main -->
  </div><!-- /.catalog-layout -->

  <button type="button" class="filter-fab" id="filterFab" aria-label="Відкрити фільтри">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
    <span>Фільтри</span>
  </button>

  <script id="store-names-data" type="application/json" set:html={JSON.stringify(STORE_NAMES)}></script>
</Layout>

<style>
  .catalog-header {
    margin-bottom: 24px;
  }
  .catalog-header h1 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 6px;
    color: var(--color-text-primary);
  }
  .catalog-header .subtitle {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
  .store-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding: 6px 6px 6px 14px;
    background: var(--color-info-bg);
    border: 1px solid var(--color-info);
    color: var(--color-info);
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .store-pill[hidden] { display: none; }
  .store-pill-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--color-info);
    color: var(--color-bg-card);
    text-decoration: none;
    font-weight: 700;
    line-height: 1;
  }
  .store-pill-clear:hover { opacity: 0.85; }
  /* Two-column page layout with sticky filter sidebar.
     <1024px collapses to a single column; sidebar becomes a drawer. */
  .catalog-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 24px;
    align-items: start;
  }
  .catalog-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 16px);
    align-self: start;
    max-height: calc(100vh - var(--header-height) - 32px);
    overflow-y: auto;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sidebar-title { font-size: 1rem; color: var(--color-text-primary); margin: 0; }
  .sidebar-close {
    display: none; /* visible only on mobile drawer */
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    width: 32px; height: 32px;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 1rem;
  }
  .sidebar-close:hover { color: var(--color-text-primary); }
  .catalog-main { min-width: 0; /* enables shrink so the table can scroll */ }
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .filter-group label, .filter-label {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }
  .filter-stock { margin-top: 4px; }
  .checkbox-label {
    display: inline-flex; align-items: center; gap: 8px;
    cursor: pointer; user-select: none;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    padding: 4px 0;
  }
  .sidebar-backdrop {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 60;
  }
  .filter-fab {
    display: none; /* visible only on mobile */
    position: fixed; right: 18px; bottom: 18px;
    z-index: 55;
    align-items: center; gap: 8px;
    padding: 12px 18px;
    background: var(--color-accent);
    color: var(--color-bg-primary);
    border: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }
  .filter-fab:hover { transform: translateY(-1px); }
  @media (max-width: 1023px) {
    .catalog-layout { grid-template-columns: 1fr; }
    .catalog-sidebar {
      position: fixed;
      top: 0; left: 0;
      width: min(320px, 88vw);
      height: 100svh;
      max-height: 100svh;
      border-radius: 0;
      border-right: 1px solid var(--color-border);
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      z-index: 70;
    }
    .catalog-layout.is-drawer-open .catalog-sidebar { transform: translateX(0); }
    .catalog-layout.is-drawer-open .sidebar-backdrop { display: block; }
    .sidebar-close { display: inline-flex; align-items: center; justify-content: center; }
    .filter-fab { display: inline-flex; }
  }
  select, input[type="text"] {
    padding: 8px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 0.95rem;
    min-width: 140px;
  }
  .results-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .results-summary {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }
  .view-toggle {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-secondary);
  }
  .view-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent;
    color: var(--color-text-secondary);
    border: 0;
    padding: 8px 14px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.15s, color 0.15s;
  }
  .view-btn + .view-btn { border-left: 1px solid var(--color-border); }
  .view-btn:hover { color: var(--color-text-primary); }
  .view-btn.active {
    background: var(--color-bg-card);
    color: var(--color-accent);
  }
  /* Color dropdown */
  /* Colour selector lives inline inside the sidebar — the menu flows below
     the summary as a static accordion instead of overflowing the column. */
  .color-dropdown { width: 100%; }
  .color-dropdown summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    font-size: 0.95rem;
  }
  .color-dropdown summary::-webkit-details-marker { display: none; }
  .color-dropdown summary::after {
    content: '▾';
    margin-left: auto;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
  }
  .color-dropdown[open] summary::after { transform: rotate(180deg); }
  .color-menu {
    margin-top: 6px;
    max-height: 280px;
    overflow-y: auto;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 6px;
    box-shadow: 0 6px 16px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .color-option {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    background: transparent;
    border: 0;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--color-text-primary);
    font-size: 0.9rem;
    text-align: left;
  }
  .color-option:hover { background: var(--color-bg-secondary); }
  .color-option.active { background: var(--color-info-bg); color: var(--color-info); }
  .swatch {
    display: inline-block;
    width: 16px; height: 16px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .swatch-sm { width: 12px; height: 12px; }
  .swatch-all {
    background: conic-gradient(#d92020, #ffd400, #2e9b4f, #1f4fbf, #7b2cbf, #d92020);
  }
  /* Table */
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .table-scroll:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .product-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-bg-secondary);
    font-size: 0.9rem;
  }
  .product-table th, .product-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }
  .product-table thead th {
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .sort-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .sort-btn:hover { color: var(--color-text-primary); }
  .sort-btn::after {
    content: '⇅';
    margin-left: 6px;
    opacity: 0.35;
    font-size: 0.85em;
  }
  th[aria-sort="ascending"] .sort-btn::after { content: '↑'; opacity: 1; color: var(--color-accent); }
  th[aria-sort="descending"] .sort-btn::after { content: '↓'; opacity: 1; color: var(--color-accent); }
  .product-table tbody tr:hover { background: var(--color-bg-card); }
  .product-table tbody tr:last-child td { border-bottom: 0; }
  .product-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .row-color {
    display: inline-flex; align-items: center; gap: 8px;
  }
  .row-link {
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .row-link:hover { color: var(--color-info); text-decoration: underline; }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }
  /* HTML [hidden] gets clobbered by display:grid/table on the class —
     restore the visibility-control behaviour. */
  .product-grid[hidden] { display: none; }
  .product-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
    /* Skip layout and paint of off-screen cards (there are 1000+). */
    content-visibility: auto;
    contain-intrinsic-size: auto 340px;
  }
  .product-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lift);
  }
  .product-card[data-instock="0"] .product-image img { opacity: 0.55; filter: grayscale(0.4); }
  .product-card-link {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .product-image {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-bg-card);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* Spool placeholder sits at the bottom layer; when <img> fails it
     removes itself via onerror and the placeholder shows through. */
  .product-image-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18%;
  }
  .product-image-fallback svg {
    width: 100%;
    height: 100%;
    /* `currentColor` on the thread path inherits from .product-image's
       inline `color:` style, which is set to the filament colour hex. */
  }
  .product-image img {
    position: relative;
    z-index: 1;
    width: 100%; height: 100%;
    object-fit: contain;
  }
  .product-info {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .product-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .product-brand {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tag {
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .tag-material {
    background: var(--color-info-bg);
    color: var(--color-info);
    border-color: transparent;
    font-weight: 600;
  }
  .tag-in {
    background: var(--color-success-bg);
    color: var(--color-success);
    border-color: transparent;
  }
  .tag-out {
    background: var(--color-danger-bg);
    color: var(--color-danger);
    border-color: transparent;
  }
  .tag-unknown {
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    border-color: var(--color-border);
  }
  .color-name { flex: 1; }
  .color-count {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .color-option.active .color-count { color: inherit; opacity: 0.7; }
  .product-name {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text-primary);
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.35;
    min-height: 2.7em;
  }
  .product-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }
  .meta-color { display: inline-flex; align-items: center; gap: 6px; }
  .product-price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
  }
  .price-spool {
    font-size: 1.3rem;
    line-height: 1.1;
    color: var(--color-text-primary);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .price-spool small {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }
  .price-kg {
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-success);
    background: var(--color-success-bg);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .stock-note { font-size: 0.85rem; color: var(--color-text-secondary); }
  .stock-note-0 { color: var(--color-danger); }
  @media (max-width: 560px) {
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .product-info { padding: 10px; gap: 6px; }
    .product-name { font-size: 0.85rem; }
    .product-price { flex-direction: column; align-items: flex-start; gap: 6px; }
    .price-spool { font-size: 1.15rem; }
  }
  .no-results {
    text-align: center;
    padding: 60px 20px;
    color: var(--color-text-secondary);
  }
</style>

<script>
  // All cards, kept in the current sort order (which is also their DOM order).
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  const grid = document.getElementById('productGrid')!;
  const tableScroll = document.getElementById('tableScroll')!;
  const tableBody = document.getElementById('productTableBody')!;
  const rowTemplate = document.getElementById('rowTemplate') as HTMLTemplateElement;
  const sortHeaders = document.querySelectorAll<HTMLElement>('th[data-sort]');
  const noResults = document.getElementById('noResults')!;
  const summary = document.getElementById('resultsSummary')!;
  const search = document.getElementById('search') as HTMLInputElement;
  const materialF = document.getElementById('materialFilter') as HTMLSelectElement;
  const brandF = document.getElementById('brandFilter') as HTMLSelectElement;
  const diameterF = document.getElementById('diameterFilter') as HTMLSelectElement;
  const weightF = document.getElementById('weightFilter') as HTMLSelectElement;
  const colorF = document.getElementById('colorFilter') as HTMLInputElement;
  const sortF = document.getElementById('sortFilter') as HTMLSelectElement;
  const inStockOnly = document.getElementById('inStockOnly') as HTMLInputElement;
  const colorDropdown = document.getElementById('colorDropdown') as HTMLDetailsElement;
  const colorSummary = document.getElementById('colorSummary')!;
  const viewBtns = document.querySelectorAll<HTMLButtonElement>('.view-btn');
  const storePill = document.getElementById('storePill')!;
  const storePillName = document.getElementById('storePillName')!;
  let currentView: 'grid' | 'table' = (localStorage.getItem('catalogView') as 'grid' | 'table') || 'grid';
  let currentStore: string = 'all';
  const storeDisplayNames: Record<string, string> = JSON.parse(document.getElementById('store-names-data')?.textContent ?? '{}');

  // The sort the cards are currently in; the server renders them in the
  // default one, so nothing moves until the user picks another.
  let domSort = 'ppk_asc';
  // Cards passing the current filters, in sort order.
  let visible: HTMLElement[] = [];
  const rowCache = new Map<HTMLElement, HTMLTableRowElement>();

  // Restore from URL
  const params = new URLSearchParams(window.location.search);
  if (params.get('material')) materialF.value = params.get('material')!;
  if (params.get('brand')) brandF.value = params.get('brand')!;
  if (params.get('diameter')) diameterF.value = params.get('diameter')!;
  if (params.get('weight')) weightF.value = params.get('weight')!;
  if (params.get('color')) colorF.value = params.get('color')!;
  if (params.get('sort')) sortF.value = params.get('sort')!;
  if (params.get('q')) search.value = params.get('q')!;
  if (params.get('instock') === '0') inStockOnly.checked = false;
  if (params.get('view') === 'table') currentView = 'table';
  if (params.get('store')) {
    currentStore = params.get('store')!;
    syncStorePill();
  }

  function syncStorePill() {
    if (currentStore === 'all') {
      storePill.hidden = true;
    } else {
      storePill.hidden = false;
      storePillName.textContent = storeDisplayNames[currentStore] ?? currentStore;
    }
  }

  // A table row for a card, cloned from #rowTemplate (so it carries the
  // page's scoped-style attributes) and filled from the card's data.
  function buildRow(card: HTMLElement): HTMLTableRowElement {
    const row = rowTemplate.content.firstElementChild!.cloneNode(true) as HTMLTableRowElement;
    const cell = (name: string) => row.querySelector<HTMLElement>(`[data-cell="${name}"]`)!;
    const d = card.dataset;
    const orDash = (value: string | undefined, unit = '') => (Number(value) ? `${value}${unit}` : '—');

    const swatch = row.querySelector<HTMLElement>('.swatch')!;
    const cardSwatch = card.querySelector<HTMLElement>('.meta-color .swatch');
    if (cardSwatch) swatch.style.background = cardSwatch.style.background;
    else swatch.remove();
    cell('color').textContent = d.color || '—';
    cell('material').textContent = d.material ?? '';
    cell('brand').textContent = d.brand ?? '';
    const link = cell('name') as HTMLAnchorElement;
    link.href = card.querySelector<HTMLAnchorElement>('.product-card-link')!.href;
    link.textContent = card.querySelector('.product-name')?.textContent ?? '—';
    cell('weight').textContent = orDash(d.weight, ' кг');
    cell('diameter').textContent = orDash(d.diameter, ' мм');
    cell('pps').textContent = orDash(d.pps);
    cell('ppk').textContent = Number(d.ppk) ? String(Math.round(Number(d.ppk))) : '—';
    const stock = cell('stock');
    stock.classList.add(d.instock === '1' ? 'tag-in' : d.instock === '0' ? 'tag-out' : 'tag-unknown');
    stock.textContent = d.instock === '1' ? 'В наявн.' : d.instock === '0' ? 'Немає' : 'Уточнюйте';
    return row;
  }

  function renderTable() {
    tableBody.replaceChildren(
      ...visible.map(card => {
        let row = rowCache.get(card);
        if (!row) rowCache.set(card, (row = buildRow(card)));
        return row;
      }),
    );
  }

  // Show the active view (or neither when nothing matches). Only the
  // active view is ever updated.
  function applyView() {
    const empty = visible.length === 0;
    grid.hidden = empty || currentView !== 'grid';
    tableScroll.hidden = empty || currentView !== 'table';
    if (!tableScroll.hidden) renderTable();
    viewBtns.forEach(b => {
      const active = b.dataset.view === currentView;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    localStorage.setItem('catalogView', currentView);
  }
  viewBtns.forEach(b => b.addEventListener('click', () => {
    currentView = b.dataset.view as 'grid' | 'table';
    applyView();
    updateUrl();
  }));

  function syncColorSummary() {
    const v = colorF.value;
    const opt = colorDropdown.querySelector<HTMLButtonElement>(`.color-option[data-value="${CSS.escape(v)}"]`);
    if (!opt) return;
    colorSummary.innerHTML = opt.innerHTML;
    colorDropdown.querySelectorAll('.color-option').forEach(o => o.classList.toggle('active', o === opt));
  }

  colorDropdown.querySelectorAll<HTMLButtonElement>('.color-option').forEach(opt => {
    opt.addEventListener('click', () => {
      colorF.value = opt.dataset.value!;
      syncColorSummary();
      colorDropdown.open = false;
      apply();
    });
  });
  syncColorSummary();

  function updateUrl() {
    const p = new URLSearchParams();
    if (materialF.value !== 'all') p.set('material', materialF.value);
    if (brandF.value !== 'all') p.set('brand', brandF.value);
    if (diameterF.value !== '1.75') p.set('diameter', diameterF.value);
    if (weightF.value !== 'all') p.set('weight', weightF.value);
    if (colorF.value !== 'all') p.set('color', colorF.value);
    if (sortF.value !== 'ppk_asc') p.set('sort', sortF.value);
    if (search.value) p.set('q', search.value);
    if (!inStockOnly.checked) p.set('instock', '0');
    if (currentView === 'table') p.set('view', 'table');
    if (currentStore !== 'all') p.set('store', currentStore);
    window.history.replaceState({}, '', window.location.pathname + (p.toString() ? '?' + p.toString() : ''));
  }

  // Map a weight in kg to the user-facing bucket id used by the filter.
  // Keep in sync with the <option value="…"> values on #weightFilter.
  function weightBucket(w: number): 'lt05' | '05to1' | '1' | '2plus' | '' {
    if (!w) return '';
    if (w < 0.5) return 'lt05';
    if (w < 1) return '05to1';
    if (w < 2) return '1';
    return '2plus';
  }

  function matches(el: HTMLElement, q: string, mat: string, brand: string, color: string, store: string, diameter: string, weight: string, onlyInStock: boolean) {
    if (mat !== 'all' && el.dataset.material !== mat) return false;
    if (brand !== 'all' && el.dataset.brand !== brand) return false;
    if (color !== 'all' && el.dataset.color !== color) return false;
    if (store !== 'all' && el.dataset.store !== store) return false;
    if (diameter !== 'all' && el.dataset.diameter !== diameter) return false;
    if (weight !== 'all' && weightBucket(Number(el.dataset.weight ?? 0)) !== weight) return false;
    // Strict: "Тільки в наявності" shows only confirmed in-stock items
    // (data-instock === '1'). Unknown ('2') and confirmed OOS ('0') hide.
    if (onlyInStock && el.dataset.instock !== '1') return false;
    if (q && !(el.dataset.search ?? '').includes(q)) return false;
    return true;
  }

  const NUMERIC_KEYS = new Set(['pps', 'ppk', 'weight', 'diameter']);
  const STRING_KEYS = new Set(['name', 'material', 'brand', 'color']);

  function compareFn(sortKey: string) {
    const m = sortKey.match(/^(.+)_(asc|desc)$/);
    if (!m) return () => 0;
    const [, key, dir] = m;
    const sign = dir === 'asc' ? 1 : -1;
    if (NUMERIC_KEYS.has(key)) {
      return (a: HTMLElement, b: HTMLElement) => {
        const av = Number(a.dataset[key] ?? 0);
        const bv = Number(b.dataset[key] ?? 0);
        // 0 means missing (or a price hidden for an unavailable item):
        // those go last in either direction.
        if (av === 0 && bv !== 0) return 1;
        if (bv === 0 && av !== 0) return -1;
        return sign * (av - bv);
      };
    }
    if (STRING_KEYS.has(key)) {
      return (a: HTMLElement, b: HTMLElement) =>
        sign * (a.dataset[key] ?? '').localeCompare(b.dataset[key] ?? '', 'uk');
    }
    return () => 0;
  }

  const plural = new Intl.PluralRules('uk');
  const PRODUCT_WORD: Record<string, string> = { one: 'товар', few: 'товари', many: 'товарів', other: 'товару' };

  function apply() {
    const q = search.value.trim().toLowerCase();
    const mat = materialF.value;
    const brand = brandF.value;
    const color = colorF.value;
    const diameter = diameterF.value;
    const weight = weightF.value;
    const onlyInStock = inStockOnly.checked;

    // Filtering never changes the relative order, so the DOM is reordered
    // only when the sort itself changes.
    if (sortF.value !== domSort) {
      cards.sort(compareFn(sortF.value));
      grid.append(...cards);
      domSort = sortF.value;
    }
    visible = [];
    for (const card of cards) {
      const show = matches(card, q, mat, brand, color, currentStore, diameter, weight, onlyInStock);
      card.style.display = show ? '' : 'none';
      if (show) visible.push(card);
    }

    const n = visible.length;
    summary.textContent = `Знайдено ${n} ${PRODUCT_WORD[plural.select(n)]}`;
    noResults.style.display = n === 0 ? '' : 'none';
    applyView();
    syncSortIndicators();
    updateUrl();
  }

  // Mirror sortF.value onto the table headers (aria-sort drives the arrow).
  function syncSortIndicators() {
    const [, activeKey, activeDir] = sortF.value.match(/^(.+)_(asc|desc)$/) ?? [];
    sortHeaders.forEach(th => {
      if (th.dataset.sort === activeKey) th.setAttribute('aria-sort', activeDir === 'asc' ? 'ascending' : 'descending');
      else th.removeAttribute('aria-sort');
    });
  }

  // A header button toggles its column's direction in sortF; the select
  // stays the single source of truth.
  sortHeaders.forEach(th => {
    th.querySelector('button')?.addEventListener('click', () => {
      const k = th.dataset.sort!;
      const [curKey, curDir] = sortF.value.split('_');
      const candidate = `${k}_${curKey === k && curDir === 'asc' ? 'desc' : 'asc'}`;
      // Not every column has both directions in the select.
      const options = [...sortF.options].map(o => o.value);
      sortF.value = options.includes(candidate)
        ? candidate
        : options.find(v => v.startsWith(k + '_')) ?? sortF.value;
      apply();
    });
  });

  search.addEventListener('input', apply);
  materialF.addEventListener('change', apply);
  brandF.addEventListener('change', apply);
  diameterF.addEventListener('change', apply);
  weightF.addEventListener('change', apply);
  sortF.addEventListener('change', apply);
  inStockOnly.addEventListener('change', apply);
  document.getElementById('storePillClear')?.addEventListener('click', e => {
    e.preventDefault();
    currentStore = 'all';
    syncStorePill();
    apply();
  });

  // Mobile drawer: FAB opens; backdrop / close button / Esc closes. On
  // narrow screens the sidebar is an off-canvas dialog: while closed it is
  // inert (out of the tab order), while open the rest of the page is.
  const layout = document.getElementById('catalogLayout')!;
  const sidebar = document.getElementById('catalogSidebar')!;
  const fab = document.getElementById('filterFab')!;
  const closeBtn = document.getElementById('sidebarClose')!;
  const backdrop = document.getElementById('sidebarBackdrop')!;
  const drawerMode = window.matchMedia('(max-width: 1023px)');
  const behindDrawer = [
    document.querySelector<HTMLElement>('.site-header'),
    document.querySelector<HTMLElement>('.catalog-header'),
    document.querySelector<HTMLElement>('.catalog-main'),
    document.querySelector<HTMLElement>('footer'),
    fab,
  ];
  function setDrawer(open: boolean) {
    layout.classList.toggle('is-drawer-open', open);
    backdrop.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    sidebar.inert = drawerMode.matches && !open;
    behindDrawer.forEach(el => { if (el) el.inert = open; });
  }
  setDrawer(false);
  drawerMode.addEventListener('change', () => setDrawer(false));
  fab.addEventListener('click', () => {
    setDrawer(true);
    closeBtn.focus();
  });
  function closeDrawer() {
    setDrawer(false);
    fab.focus();
  }
  closeBtn.addEventListener('click', closeDrawer);
  backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && layout.classList.contains('is-drawer-open')) closeDrawer();
  });

  apply();
</script>
