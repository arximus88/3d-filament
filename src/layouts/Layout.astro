---
import BaseHead from "../components/BaseHead.astro";
import Icons from "../components/Icons.astro";
import { dataDate, materialSummaries } from "../utils/catalog";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
}

const { title, description, canonicalURL } = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
    />
    <slot name="head" />
    <style is:global>
      /* One palette: every colour is light-dark(<light>, <dark>). Which
         side applies follows the system setting, unless the visitor picked
         a theme (data-theme, set before first paint in BaseHead). */
      :root {
        color-scheme: light dark;
        --color-bg-primary: light-dark(#f6f7f8, #1f2430);
        --color-bg-secondary: light-dark(#ffffff, #232834);
        --color-bg-card: light-dark(#f3f4f5, #282e3a);
        --color-text-primary: light-dark(#2d333b, #cbccc6);
        --color-text-secondary: light-dark(#6a727d, #707a8c);
        --color-accent: light-dark(#f08019, #ffcc66);
        --color-accent-hover: light-dark(#ff9940, #ffd580);
        --color-border: light-dark(#e3e5e8, #3b4252);
        --color-success: light-dark(#5f8a00, #a6cc70);
        --color-info: light-dark(#399ee6, #5ccfe6);
        --color-danger: light-dark(#d92020, #ff6666);
        --color-success-bg: light-dark(rgba(134, 179, 0, 0.1), rgba(166, 204, 112, 0.15));
        --color-info-bg: light-dark(rgba(57, 158, 230, 0.1), rgba(92, 207, 230, 0.15));
        --color-danger-bg: light-dark(rgba(217, 32, 32, 0.1), rgba(255, 102, 102, 0.15));
        --shadow-lift: 0 10px 24px light-dark(rgba(30, 40, 60, 0.12), rgba(0, 0, 0, 0.28));
        --radius-sm: 5px;
        --radius-md: 8px;
        --radius-lg: 12px;
      }
      :root[data-theme="light"] { color-scheme: light; }
      :root[data-theme="dark"] { color-scheme: dark; }
      :root { --header-height: 56px; }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        background: var(--color-bg-primary);
        color: var(--color-text-primary);
        line-height: 1.6;
        transition: background 0.3s, color 0.3s;
      }
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        height: var(--header-height);
        background: color-mix(in srgb, var(--color-bg-primary) 88%, transparent);
        backdrop-filter: saturate(160%) blur(12px);
        -webkit-backdrop-filter: saturate(160%) blur(12px);
        border-bottom: 1px solid var(--color-border);
      }
      .site-header-inner {
        max-width: 1400px;
        margin: 0 auto;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        gap: 16px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--color-text-primary);
        font-weight: 600;
        font-size: 1.05rem;
        white-space: nowrap;
      }
      .brand-flag { flex: none; border-radius: 3px; }
      .brand-name-accent { color: var(--color-accent); }

      /* Easter egg: keep the pointer on the logo and a nozzle prints a line
         of filament under it. Moving away retracts it. */
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .brand-name { position: relative; }
        .brand-name::after,
        .brand-name::before {
          content: "";
          position: absolute;
          pointer-events: none;
        }
        .brand-name::after {
          left: 0;
          right: 0;
          bottom: -5px;
          height: 2px;
          border-radius: 2px;
          background: var(--color-accent);
          scale: 0 1;
          transform-origin: left;
          transition: scale 0.25s ease-in;
        }
        .brand-name::before {
          left: 0;
          bottom: -3px;
          translate: -50% 0;
          border: 5px solid transparent;
          border-top: 7px solid var(--color-text-secondary);
          border-bottom: 0;
          opacity: 0;
          transition: left 0.25s ease-in, opacity 0.15s;
        }
        .brand:hover .brand-name::after {
          scale: 1 1;
          transition: scale 1.6s linear 1.2s;
        }
        .brand:hover .brand-name::before {
          left: 100%;
          opacity: 1;
          transition: left 1.6s linear 1.2s, opacity 0.2s 1s;
        }
      }
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 28px 24px 40px;
      }
      .primary-nav {
        display: flex;
        gap: 6px;
        margin-left: auto;
      }
      .primary-nav a {
        color: var(--color-text-secondary);
        text-decoration: none;
        padding: 7px 14px;
        border-radius: var(--radius-md);
        font-weight: 500;
        font-size: 0.95rem;
        transition: background 0.15s, color 0.15s;
      }
      .primary-nav a:hover {
        color: var(--color-text-primary);
        background: var(--color-bg-secondary);
      }
      .primary-nav a[aria-current="page"] {
        color: var(--color-accent);
        background: var(--color-bg-secondary);
      }
      .theme-toggle {
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
        width: 36px;
        height: 36px;
        border-radius: var(--radius-md);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        flex-shrink: 0;
      }
      .theme-toggle:hover {
        border-color: var(--color-accent);
        transform: scale(1.05);
      }
      .info-icon {
        width: 18px;
        height: 18px;
        opacity: 0.8;
        flex-shrink: 0;
      }
      footer {
        text-align: center;
        padding: 32px 20px 40px;
        color: var(--color-text-secondary);
        border-top: 1px solid var(--color-border);
        margin-top: 60px;
        font-size: 0.9rem;
      }
      .footer-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px 18px;
        margin-bottom: 14px;
      }
      .footer-nav a, .footer-nav button { color: var(--color-text-secondary); text-decoration: none; }
      .footer-nav a:hover, .footer-nav button:hover { color: var(--color-accent); }
      .footer-nav button { padding: 0; border: 0; background: none; font: inherit; cursor: pointer; }

      /* Text pages: material pages, price summary, about. */
      .prose { max-width: 920px; margin: 0 auto; }
      .prose h1 {
        font-size: clamp(1.6rem, 4vw, 2.1rem);
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin-bottom: 6px;
      }
      .prose h2 { font-size: 1.3rem; letter-spacing: -0.01em; margin: 36px 0 12px; }
      .prose h3 { font-size: 1.02rem; margin-bottom: 4px; }
      .prose p, .prose ul { margin-bottom: 14px; }
      .prose ul { padding-left: 22px; }
      .prose li { margin-bottom: 6px; }
      .prose a { color: var(--color-info); text-decoration: none; }
      .prose a:hover { text-decoration: underline; }
      .prose .updated, .prose .muted { color: var(--color-text-secondary); font-size: 0.9rem; }
      .prose .crumbs { font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 10px; }
      .prose .cta { font-weight: 600; color: var(--color-accent); }
      .prose .stat-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin: 20px 0;
      }
      .prose .stat-row > div {
        background: var(--color-bg-secondary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 12px 16px;
      }
      .prose .stat-row dt { font-size: 0.8rem; color: var(--color-text-secondary); }
      .prose .stat-row dd { font-size: 1.25rem; font-weight: 700; font-variant-numeric: tabular-nums; }
      .prose .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        background: var(--color-bg-secondary);
        margin-bottom: 14px;
      }
      .prose table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
      .prose th, .prose td { padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--color-border); }
      .prose thead th {
        background: var(--color-bg-card);
        color: var(--color-text-secondary);
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
      }
      .prose tbody tr:last-child td { border-bottom: 0; }
      .prose .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .prose .faq-item { margin-bottom: 18px; }
      .prose .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
      .prose .chips li { margin: 0; }
      .prose .chips a, .material-links a {
        display: inline-block;
        padding: 4px 12px;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: var(--color-bg-secondary);
        color: var(--color-text-primary);
        font-size: 0.88rem;
        text-decoration: none;
      }
      .prose .chips a:hover, .material-links a:hover { border-color: var(--color-accent); color: var(--color-accent); text-decoration: none; }
      @media (max-width: 640px) {
        .brand-name { display: none; }
        .primary-nav a { padding: 6px 10px; font-size: 0.9rem; }
        .site-header-inner { padding: 0 12px; gap: 8px; }
        .container { padding: 18px 12px 32px; }
      }
    </style>
  </head>
  <body>
    <Icons />
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand">
          <svg class="brand-flag" viewBox="0 0 24 16" width="24" height="16" aria-hidden="true">
            <rect width="24" height="8" fill="#0057b7" />
            <rect y="8" width="24" height="8" fill="#ffd700" />
          </svg>
          <span class="brand-name">3D Філамент <span class="brand-name-accent">UA</span></span>
        </a>
        <nav class="primary-nav" aria-label="Основна навігація">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Каталог</a>
          <a href="/prices/" aria-current={/^\/(prices|material)\//.test(Astro.url.pathname) ? 'page' : undefined}>Ціни</a>
          <a href="/shops/" aria-current={/^\/(shops|company)\//.test(Astro.url.pathname) ? 'page' : undefined}>Магазини</a>
        </nav>
        <button class="theme-toggle" id="themeToggle" aria-label="Змінити тему">
          <svg class="info-icon" id="themeIcon"><use href="#icon-moon"></use></svg>
        </button>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer>
      <nav class="footer-nav" aria-label="Матеріали">
        {materialSummaries.map(m => <a href={`/material/${m.slug}/`}>{m.material}</a>)}
      </nav>
      <nav class="footer-nav" aria-label="Розділи сайту">
        <a href="/">Каталог</a>
        <a href="/prices/">Ціни</a>
        <a href="/shops/">Магазини</a>
        <a href="/about/">Про каталог</a>
        <button type="button" id="ruLink">На русский</button>
      </nav>
      <p>Ціни й наявність зібрано з сайтів магазинів {dataDate}</p>
    </footer>

    <script>
      // Theme toggle
      const themeToggle = document.getElementById("themeToggle");
      const themeIcon = document
        .getElementById("themeIcon")
        ?.querySelector("use");
      const root = document.documentElement;
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
      const systemTheme = () => (systemDark.matches ? "dark" : "light");
      // data-theme is present only when the visitor's choice differs from
      // the system setting; BaseHead applies the stored one before paint.
      const activeTheme = () => root.dataset.theme ?? systemTheme();

      function syncIcon() {
        themeIcon?.setAttribute("href", activeTheme() === "dark" ? "#icon-sun" : "#icon-moon");
      }
      function setTheme(theme: string) {
        // Choosing what the system already says means "follow the system".
        if (theme === systemTheme()) {
          delete root.dataset.theme;
          localStorage.removeItem("theme");
        } else {
          root.dataset.theme = theme;
          localStorage.setItem("theme", theme);
        }
        syncIcon();
      }
      syncIcon();
      themeToggle?.addEventListener("click", () =>
        setTheme(activeTheme() === "dark" ? "light" : "dark"),
      );
      systemDark.addEventListener("change", syncIcon);
      // Keep other open tabs in step.
      window.addEventListener("storage", (e) => {
        if (e.key !== "theme") return;
        if (e.newValue === "light" || e.newValue === "dark") root.dataset.theme = e.newValue;
        else delete root.dataset.theme;
        syncIcon();
      });
    </script>
    <script>
      import "../scripts/eggs.ts";
    </script>
  </body>
</html>
